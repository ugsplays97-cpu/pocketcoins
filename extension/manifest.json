{
  "manifest_version": 3,
  "name": "Pocket Coins",
  "version": "1.3.0",
  "description": "A tiny side game: flip pretend coins and duel real players online in Walls, Connect 4, Reaction and Rock Paper Scissors.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png", "default_title": "Pocket Coins" },
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "browser_specific_settings": {
    "gecko": { "id": "pocket-coins@pocketcoins.game", "strict_min_version": "115.0" }
  }
}
